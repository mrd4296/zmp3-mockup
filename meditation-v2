        case 'idle':
        case 'paused':
        case 'ended':
          return "asset://zic_play_solid_24";
      }
    },
    onPlaybackStateChanged: state => {
      if (getPlaybackState() === state) {
        return;
      }
      setPlaybackState(state);
      switch (state) {
        case 'ended':
          onEnded('finished');
          break;
        default:
          break;
      }
    },
    onPlaybackFailed: _ => {
      onEnded('failed');
    },
    onPlaybackTimeChanged: (currentTime, duration) => {
      const last = lastPlayerTimeRef.current;
      // first frame
      if (last === undefined) {
        lastPlayerTimeRef.current = currentTime;
        setPlaybackTime(currentTime);
        return;
      }
      // Detect loop reset (time jumped backwards)
      if (currentTime < last) {
        // Add one full loop duration
        loopAccumRef.current += duration;
      }
      lastPlayerTimeRef.current = currentTime;
      const continuousMs = loopAccumRef.current + currentTime;
      if (getPlaybackTime() === continuousMs) return;
      // Optionally end when reaching total duration
      if (continuousMs >= playbackDuration) {
        player.stop();
        voicePlayer.stop();
        onEnded('finished');
      } else {
        setPlaybackTime(continuousMs);
      }
    },
    onPlaybackButtonTapped: () => {
      if (isDimMode()) return;
      onTappedAny();
      if (getPlaybackState() === 'buffering') {
        return;
      }
      if (player.playing) {
        player.pause();
        voicePlayer.pause();
      } else {
        player.play();
        voicePlayer.play();
      }
    },
    setVoice: voice => {
      if (voice) {
        const source = item.voiceSource || SERVICES.mediation.repo.defaultVoiceSource();
        voicePlayer.replace(source, {
          autoPlay: true,
          shouldPlayInBackground: true
        });
      } else {
        voicePlayer.stop();
      }
    }
  });

  // Add event listener for playback player
  useEffect(() => {
    // Add event listener for playback status update
    let playbackStatusUpdate = player.addListener('playbackStatusUpdate', status => {
      controllerRef.current?.onPlaybackStateChanged(status.playbackState);
      if (status.duration >= 0) {
        controllerRef.current?.onPlaybackTimeChanged(status.currentTime * 1000, status.duration * 1000);
      }
    });
    // Add event listener for playback failed
    let playbackFailed = player.addListener('playbackFailed', error => {
      controllerRef.current?.onPlaybackFailed(error);
    });
    // Enable loop mode
    player.loop = true;

    // Reset accumulators when source changes
    loopAccumRef.current = 0;
    lastPlayerTimeRef.current = undefined;
    setPlaybackTime(0);
    player.replace(item.source, {
      autoPlay: true,
      shouldPlayInBackground: true
    });
    return () => {
      player.removeListener('playbackStatusUpdate', playbackStatusUpdate);
      player.removeListener('playbackFailed', playbackFailed);
    };
  }, [player.id, item.id]);

  // Add event listener for voice player
  useEffect(() => {
    // Add event listener for voice changed
    const playbackUsecase = SERVICES.mediation.playbackUsecase;
    const setVoice = controllerRef.current.setVoice;
    playbackUsecase.addEventListener('voiceChanged', setVoice);
    if (playbackUsecase.voice) {
      setVoice(playbackUsecase.voice);
    }
    // Add event listener for voice failed
    let voiceFailed = voicePlayer.addListener('playbackFailed', error => {
      //TODO: show error message
    });
    return () => {
      // Remove event listener for voice changed
      SERVICES.mediation.playbackUsecase.removeEventListener('voiceChanged', setVoice);
      voicePlayer.removeListener('playbackFailed', voiceFailed);
    };
  }, [voicePlayer.id]);
  return View({
    style: MeditationDetailStyles.playbackContainer
  }, () => [View({
