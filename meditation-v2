class Utils {
  static formatTime(time) {
    if (time <= 0) {
      return {
        days: 0,
        hours: 0,
        minutes: 0,
        seconds: 0
      };
    }
    const totalSeconds = Math.floor(time / 1000);
    const days = Math.floor(totalSeconds / 86400);
    const hours = Math.floor(totalSeconds % 86400 / 3600);
    const minutes = Math.floor(totalSeconds % 3600 / 60);
    const seconds = totalSeconds % 60;
    return {
      days,
      hours,
      minutes,
      seconds
    };
  }
  static formatTimeString(time) {
    const countdown = Utils.formatTime(time);
    if (countdown.days > 0) {
      return `${countdown.days} ngày ${String(countdown.hours).padStart(2, '0')}:${String(countdown.minutes).padStart(2, '0')}:${String(countdown.seconds).padStart(2, '0')}`;
    } else if (countdown.hours > 0) {
      return `${String(countdown.hours).padStart(2, '0')}:${String(countdown.minutes).padStart(2, '0')}:${String(countdown.seconds).padStart(2, '0')}`;
    } else {
      return `${String(countdown.minutes).padStart(2, '0')}:${String(countdown.seconds).padStart(2, '0')}`;
    }
  }
  static displayTimeString(time) {
    const countdown = Utils.formatTime(time);
    if (countdown.days > 0) {
      return `${countdown.days} ngày`;
    } else if (countdown.hours > 0) {
      return `${countdown.days} giờ`;
    } else if (countdown.minutes > 0) {
      return `${countdown.minutes} phút`;
    } else {
      return `${countdown.seconds} giây`;
    }
  }
}
