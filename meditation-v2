class MeditationPlaybackUsecaseImpl {
  _storage = KVStorage.Local('zmp3.meditation');
  _voice = undefined;
  get voice() {
    if (this._voice === undefined) {
      this._voice = this._storage.getBool('settings.voice-enabled') ?? false;
    }
    return this._voice;
  }
  set voice(voice) {
    if (this._voice === voice) return;
    this._voice = voice;
    this._eventCallbacks.get('voiceChanged').forEach(cb => cb(voice));
    this._storage.setBool('settings.voice-enabled', voice);
  }
  _eventCallbacks = new Map();
  addEventListener(event, callback) {
    if (!this._eventCallbacks.has(event)) {
      this._eventCallbacks.set(event, []);
    }
    this._eventCallbacks.get(event).push(callback);
  }
  removeEventListener(event, callback) {
    if (this._eventCallbacks.has(event)) {
      this._eventCallbacks.set(event, this._eventCallbacks.get(event).filter(cb => cb !== callback));
    }
  }
}
