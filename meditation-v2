  const playbackDuration = item.duration;
  const player = useAudioPlayer();
  const voicePlayer = useAudioPlayer();
  const [getPlaybackTime, setPlaybackTime] = useState(0);
  const [getPlaybackState, setPlaybackState] = useState('idle');

  // Accumulator for continuous time across loops
  const loopAccumRef = useRef(0); // ms
  const lastPlayerTimeRef = useRef(undefined);
  const controllerRef = useRef({
    playbackIcon: () => {
      switch (getPlaybackState()) {
        case 'buffering':
        case 'ready':
        case 'playing':
